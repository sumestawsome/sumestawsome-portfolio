# Firebase Configuration Template for sumestawsome.xyz
# Salin berkas ini ke `.env.local` dan isi dengan kredensial dari Firebase Console

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=sumestawsome-xyz.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sumestawsome-xyz
VITE_FIREBASE_STORAGE_BUCKET=sumestawsome-xyz.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudinary Configuration (Client-Side Safe)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=sumesta_blog

# Rumahweb CDN Endpoint
VITE_RUMAHWEB_CDN_URL=https://cdn.sumestawsome.xyz
VITE_UPLOAD_SECRET_TOKEN=token_rahasia_untuk_keamanan_upload

