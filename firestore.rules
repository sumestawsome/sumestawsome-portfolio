rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi artikel blog: Publik dapat membaca, perubahan hanya oleh admin terautentikasi
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Aturan global fallback
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}